{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "SayPlay Recorder",
	"mainBinaryName": "SayPlay Recorder",
	"identifier": "com.sayandplayschool.recorder",
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["sayplay-recorder"]
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": false,
		"targets": "all",
		"category": "Video",
		"longDescription": "SayPlay Recorder — school screen recorder (based on Cap, AGPLv3). Studio Mode, separate mic and system audio. One installer for all 64-bit Windows 10/11 PCs.",
		"externalBin": ["binaries/cap-muxer", "binaries/cap-cli"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/macos/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"assets/backgrounds/macOS/*": "assets/backgrounds/macOS/",
			"assets/backgrounds/blue/*": "assets/backgrounds/blue/",
			"assets/backgrounds/cities/*": "assets/backgrounds/cities/",
			"assets/backgrounds/dark/*": "assets/backgrounds/dark/",
			"assets/backgrounds/orange/*": "assets/backgrounds/orange/",
			"assets/backgrounds/purple/*": "assets/backgrounds/purple/",
			"assets/music/*.mp3": "assets/music/"
		},
		"fileAssociations": [
			{
				"ext": ["cap"],
				"name": "SayPlay Project",
				"mimeType": "application/x-cap-project",
				"role": "Editor"
			}
		],
		"macOS": {
			"minimumSystemVersion": "12.3",
			"entitlements": "packaging/macos/Entitlements.plist",
			"frameworks": ["../../target/native-deps/Spacedrive.framework"],
			"files": {
				"Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings",
				"Resources/zh-Hans.lproj/InfoPlist.strings": "macos/zh-Hans.lproj/InfoPlist.strings",
				"Resources/ja.lproj/InfoPlist.strings": "macos/ja.lproj/InfoPlist.strings",
				"Resources/fr.lproj/InfoPlist.strings": "macos/fr.lproj/InfoPlist.strings",
				"Resources/es.lproj/InfoPlist.strings": "macos/es.lproj/InfoPlist.strings",
				"Resources/de.lproj/InfoPlist.strings": "macos/de.lproj/InfoPlist.strings",
				"Resources/hi.lproj/InfoPlist.strings": "macos/hi.lproj/InfoPlist.strings"
			},
			"dmg": {
				"background": "packaging/macos/dmg-background.png",
				"appPosition": {
					"x": 180,
					"y": 140
				},
				"applicationFolderPosition": {
					"x": 480,
					"y": 140
				}
			}
		},
		"windows": {
			"nsis": {
				"headerImage": "packaging/windows/nsis-header.bmp",
				"sidebarImage": "packaging/windows/nsis-sidebar.bmp",
				"installerIcon": "icons/icon.ico",
				"installerHooks": "packaging/windows/installer-hooks.nsh",
				"compression": "lzma",
				"installMode": "both",
				"languages": ["English", "Russian"]
			},
			"webviewInstallMode": {
				"type": "skip"
			}
		},
		"linux": {
			"deb": {
				"depends": [
					"libc6 (>= 2.39)",
					"libva2",
					"libva-drm2",
					"pulseaudio-utils",
					"libpipewire-0.3-0",
					"libasound2t64 | libasound2",
					"libxkbcommon0",
					"libxkbcommon-x11-0",
					"libx11-6",
					"libssl3t64 | libssl3",
					"libwayland-client0",
					"libwayland-egl1",
					"libegl1",
					"libvulkan1"
				]
			}
		}
	}
}
